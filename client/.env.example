# ===================================================
# Kiara Medicals Frontend - Environment Template
# Copy to client/.env.development or client/.env.production
# ===================================================

# Application brand title
VITE_APP_NAME=Kiara Medicals

# Backend API Base URL:
# - Leave empty ("") for same-origin deployment (Express serving client/dist)
#   or when using Vite's built-in /api dev proxy.
# - Or set an explicit origin when frontend & backend are hosted separately:
#   e.g. http://localhost:5001 or https://kiara-medicals.onrender.com
VITE_API_URL=http://localhost:5001
