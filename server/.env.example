# ===================================================
# Kiara Medicals Backend - Environment Template
# Copy this file to server/.env for local development
# ===================================================

# --- Server ---
NODE_ENV=development
PORT=5001

# Allowed frontend origins (comma-separated, or * for local dev)
CORS_ORIGIN=http://localhost:5173

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=kiara_medicals

# Set true for cloud MySQL requiring TLS (e.g. Aiven, AWS RDS, PlanetScale)
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=2500

# Set true to bypass MySQL and run immediately with local mock data
DB_USE_MOCK=false

# --- Authentication (JWT) ---
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_random_production_secret_key
JWT_EXPIRES_IN=8h
