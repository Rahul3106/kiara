# ===================================================
# Kiara Medicals - Production Environment Variables
# ===================================================

# --- Node Server Environment ---
NODE_ENV=production
PORT=5000

# Comma-separated allowed origins (leave empty or set your domain)
CORS_ORIGIN=https://yourdomain.com

# --- Database Connection (MySQL / Aiven / AWS RDS / DigitalOcean) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=kiara_admin
DB_PASSWORD=your_secure_db_password
DB_NAME=kiara_medicals
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000
DB_USE_MOCK=false

# --- Authentication Security ---
# Generate a secure 64+ char random string: openssl rand -base64 32
JWT_SECRET=replace_this_with_a_very_secure_random_production_secret_key_32_chars_min
JWT_EXPIRES_IN=8h

# --- Frontend Build Variables (Vite) ---
VITE_APP_NAME=Kiara Medicals
# Leave empty when Express serves client/dist; set URL only if split-hosted:
VITE_API_URL=
